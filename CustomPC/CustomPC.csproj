<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>CustomPC</Product>
    <Description>PC building, inventory and store order management for one Windows workstation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" />
    <EmbeddedResource Include="Assets\Icons\*.svg" />
    <None Update="Assets\Icons\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Fonts\*.ttf" />
    <None Update="Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
    <PackageReference Include="Svg" Version="3.4.8" />
    <Compile Update="*Form.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="EmptyStateControl.cs;ProductCard.cs;ProductThumbnail.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

</Project>
